{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/space-bunny-free",
  "small_model": "opencode/space-bunny-free",
  "provider": {
    "opencode": {
      "models": {
        "space-bunny-free": {
          "variants": {
            "max": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "shred *": "deny",
      "truncate *": "deny",
      "find * -delete*": "deny",
      "find * -exec rm*": "deny",
      "*git* push*": "deny",
      "*git* pull*": "deny",
      "*git* fetch*": "deny",
      "*git* commit*": "deny",
      "*git* add*": "deny",
      "*git* rm*": "deny",
      "*git* mv*": "deny",
      "*git* switch*": "deny",
      "*git* checkout*": "deny",
      "*git* merge*": "deny",
      "*git* rebase*": "deny",
      "*git* cherry-pick*": "deny",
      "*git* revert*": "deny",
      "*git* reset*": "deny",
      "*git* restore*": "deny",
      "*git* clean*": "deny",
      "*git* stash*": "deny",
      "*git* submodule*": "deny",
      "*git* config*": "deny",
      "*git* remote*": "deny",
      "*git* tag*": "deny",
      "*git* branch*": "deny",
      "*git* update-ref*": "deny",
      "*git* symbolic-ref*": "deny",
      "*git* worktree*": "deny",
      "*git* am*": "deny",
      "*git* apply*": "deny",
      "*git* notes*": "deny",
      "*git* gc*": "deny",
      "*git* prune*": "deny",
      "*git* filter-branch*": "deny",
      "*git* replace*": "deny",
      "*git* init*": "deny",
      "*git* clone*": "deny",
      "*git* -c *": "deny",
      "*git* --git-dir*": "deny",
      "*git* --work-tree*": "deny",
      "gh repo create*": "deny",
      "sudo *": "deny",
      "docker system prune*": "deny",
      "docker volume rm*": "deny"
    },
    "pw_*": "deny",
    "question": "deny"
  },
  "mcp": {
    "pw": {
      "type": "local",
      "command": [
        "scripts/orch/pw-mcp.sh"
      ],
      "enabled": false,
      "timeout": 20000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    }
  }
}
