{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "/home/dlesieur/Documents/osionos/.claude/rules/*.md"
  ],

  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",

      "rm *": "deny",
      "rmdir *": "deny",
      "shred *": "deny",
      "truncate *": "deny",
      "find * -delete*": "deny",
      "find * -exec rm*": "deny",

      "git push*": "deny",
      "git remote add*": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git restore*": "deny",
      "git clean*": "deny",
      "git stash*": "deny",
      "gh repo create*": "deny",

      "sudo *": "deny",
      "docker system prune*": "deny",
      "docker volume rm*": "deny"
    }
  }
}
