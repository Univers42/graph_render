{
  "$defs": {
    "EdgeGeometry": {
      "description": "Edge geometry. Edge `e` owns points `offsets[e]..offsets[e+1]`; point `p` is\n`(pts[2p], pts[2p+1])`. A row holds the interior points, source to target; an empty\nrow is drawn straight.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Straight from source to target; nothing stored.",
          "properties": {
            "kind": {
              "const": "Line",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Straight segments through each edge's interior points.",
          "properties": {
            "kind": {
              "const": "Polyline",
              "type": "string"
            },
            "offsets": {
              "description": "`m + 1` point offsets, from 0, never decreasing.",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "pts": {
              "description": "`2 × offsets[m]` coordinates, x then y for each point.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "offsets",
            "pts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A curve of one degree for every edge, through each edge's control points.",
          "properties": {
            "degree": {
              "description": "The curve degree, at least 1 (2 quadratic, 3 cubic).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "Curve",
              "type": "string"
            },
            "offsets": {
              "description": "`m + 1` point offsets, from 0, never decreasing.",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "pts": {
              "description": "`2 × offsets[m]` coordinates, x then y for each point.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "degree",
            "offsets",
            "pts"
          ],
          "type": "object"
        }
      ]
    },
    "Edges": {
      "additionalProperties": false,
      "description": "Edge identity and endpoints.",
      "properties": {
        "id": {
          "description": "Stable edge ids, unique.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "description": "Each edge's source, as a node id.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "description": "Each edge's target, as a node id.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "type": "object"
    },
    "FormatVersion": {
      "additionalProperties": false,
      "description": "A snapshot format version.",
      "properties": {
        "major": {
          "description": "Incremented on any change an older reader would misread.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "description": "Incremented on additive changes an older reader can safely ignore.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "Geometry": {
      "additionalProperties": false,
      "description": "One geometry for the whole snapshot: one node kind, one edge kind.",
      "properties": {
        "edges": {
          "$ref": "#/$defs/EdgeGeometry",
          "description": "Edge geometry."
        },
        "nodes": {
          "$ref": "#/$defs/NodeGeometry",
          "description": "Node geometry."
        }
      },
      "required": [
        "edges",
        "nodes"
      ],
      "type": "object"
    },
    "NodeGeometry": {
      "description": "Node geometry as columns, one value per node, in node order. Every value is a\nfinite `f32`, written as the shortest decimal that reads back as it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Centres.",
          "properties": {
            "kind": {
              "const": "Point",
              "type": "string"
            },
            "x": {
              "description": "Horizontal centre.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "y": {
              "description": "Vertical centre.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "x",
            "y"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Centres and radii.",
          "properties": {
            "kind": {
              "const": "Circle",
              "type": "string"
            },
            "r": {
              "description": "Radius, never negative.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "x": {
              "description": "Horizontal centre.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "y": {
              "description": "Vertical centre.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "r",
            "x",
            "y"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Boxes.",
          "properties": {
            "h": {
              "description": "Height, never negative.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "kind": {
              "const": "Box",
              "type": "string"
            },
            "w": {
              "description": "Width, never negative.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "x": {
              "description": "Horizontal centre.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            },
            "y": {
              "description": "Vertical centre.",
              "items": {
                "format": "float",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "h",
            "w",
            "x",
            "y"
          ],
          "type": "object"
        }
      ]
    },
    "Nodes": {
      "additionalProperties": false,
      "description": "Node identity.",
      "properties": {
        "id": {
          "description": "Stable node ids, unique. A node's position here is its position in every node column.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Notes": {
      "additionalProperties": false,
      "description": "The notes section (format 0.3), one entry per note in both columns, strictly\nascending by `(code, index)`: a closed, canonical set, so a reserved or unallocated\ncode, a repeat or an out-of-order note is refused.",
      "properties": {
        "code": {
          "description": "Each note's code: 1 hierarchy.cycle_edge_dropped, 2 hierarchy.extra_parent_dropped,\n3 packing.approximate. 4-6 are reserved for later phases and refused, as is any\nother.",
          "items": {
            "enum": [
              1,
              2,
              3
            ],
            "format": "uint32",
            "type": "integer"
          },
          "type": "array"
        },
        "index": {
          "description": "Each note's index: for codes 1 and 2 an edge position (an index into edges.id,\nbelow its length); for code 3 the literal 4294967295 (u32::MAX), the whole\nsnapshot.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "code",
        "index"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A graph-motor snapshot, semantic face: canonical JSON (compact, keys sorted by bytes,\none trailing newline). Byte layout and rules: `docs/contract/binary-layout.md`.",
  "properties": {
    "edges": {
      "$ref": "#/$defs/Edges",
      "description": "Every edge's identity and endpoints, in edge order."
    },
    "geometry": {
      "$ref": "#/$defs/Geometry",
      "description": "Where and how every node and edge is drawn."
    },
    "nodes": {
      "$ref": "#/$defs/Nodes",
      "description": "Every node's identity, in node order."
    },
    "notes": {
      "$ref": "#/$defs/Notes",
      "default": {
        "code": [],
        "index": []
      },
      "description": "What the stages repaired or approximated. Required from format 0.3; below 0.3 a\nsnapshot carries none and an absent member reads as none. JSON Schema cannot tie\na member's presence to the version's value, so this schema lists it as optional\nand the reader enforces the rule."
    },
    "version": {
      "$ref": "#/$defs/FormatVersion",
      "default": {
        "major": 0,
        "minor": 0
      },
      "description": "The format version. A reader refuses a newer major; absent reads as 0.0."
    }
  },
  "required": [
    "edges",
    "geometry",
    "nodes"
  ],
  "title": "Snapshot",
  "type": "object"
}
