# from docs/reports/phase-03.md:93 — p3 deterministic layouts: the 1000-seed gate, the fixture
# differential in both arms, the geometry invariants, the ledger. `hashgate-1000` is the row
# the whole phase-03..08 chain reports at 3052 s; `# slow:` moves it to the end.
# ---------------------------------------------------------------------------------------------
roundtrip-1000|0|scripts/orch/gr cargo run -q --release -p graph-cli -- roundtrip --seeds 1000
emit-fixtures-1000|0|scripts/orch/gr cargo run -q -p graph-cli -- emit-fixtures --seeds 1000
oracle-layouts|0|scripts/orch/gr cargo run -q -p graph-cli -- oracle-layouts
geometry-invariants|0|scripts/orch/gr cargo test -p graph-core geometry_invariants
codegen-check|0|scripts/orch/gr cargo run -q -p graph-cli -- codegen --check
ge-check|0|scripts/orch/ge-check.sh

# ---------------------------------------------------------------------------------------------
# from docs/reports/phase-04.md:106 — the wasm transport: the release binary, the no-bindgen
# invariant, and the SDK's own typecheck/lint. The TypeScript oracle arm needs the ts loader
# and node_modules, so npm ci is chained rather than assumed from the row above.
# ---------------------------------------------------------------------------------------------
wasm-release|0|scripts/orch/gr cargo build -p graph-wasm --release --target wasm32-unknown-unknown
no-bindgen|0|scripts/orch/gr bash -c 'cargo tree -p graph-wasm >target/graph-wasm-deps.txt; grep -qi wasm-bindgen target/graph-wasm-deps.txt && exit 1 || exit 0'
oracle-diff|0|scripts/orch/node-slim.sh bash -c 'npm ci --ignore-scripts >/dev/null && node --experimental-strip-types --experimental-loader ./tests/ts-extension-loader.mjs harness/oracle-diff.mjs'
sdk-typecheck|0|scripts/orch/node-slim.sh bash -c 'npm ci --ignore-scripts >/dev/null && npx tsc -p crates/graph-sdk-js/tsconfig.json --noEmit'
sdk-test|0|scripts/orch/node-slim.sh npm run sdk:test
# The control for `sdk-test` above, and it fails by breaking the test's *input*, never by
# inverting the expected exit: the whole SDK package is copied to target/, so the copy's
# `../src/wasm.ts` import still resolves, and the module the ABI test hands the loader is made
# to report one version above the SDK's. The loader refuses it (C4's handshake), the second
# test fails, the run exits non-zero. Without this row `sdk-test` could go green by testing
# nothing at all — the same vacuous pass prompts/RESUME.md:155 records for a knob at 0.9.
sdk-test-control|nonzero|scripts/orch/node-slim.sh bash -c 'rm -rf target/sdk-test-control && cp -R crates/graph-sdk-js target/sdk-test-control && sed -i "s/moduleReporting(ABI_VERSION)/moduleReporting(ABI_VERSION + 1)/" target/sdk-test-control/test/abi-version.test.mjs && grep -q "ABI_VERSION + 1" target/sdk-test-control/test/abi-version.test.mjs && node --test --experimental-strip-types "target/sdk-test-control/test/**/*.test.mjs"'
# `sdk-lint` now lints the whole SDK package — `test/` and `scripts/` as well as `src`. It used
# to name `crates/graph-sdk-js/src` only, which is how 52 errors in the `.mjs` files (a dead
# import, a face that sent `null` instead of `1e999`, and 50 undeclared Node/web globals) sat
# unseen through every develop gate.
sdk-lint|0|scripts/orch/node-slim.sh bash -c 'npm ci --ignore-scripts >/dev/null && npm run sdk:lint'
# The control for `sdk-lint` above: eslint must go red on an undeclared name, or the row above
# is measuring a linter that never fires. It writes nothing under `crates/` — the source
# arrives on eslint's stdin under a `.mjs` filename the new config object matches — and it
# fails by the defect's own shape (a `no-undef` report, exit 1) rather than by inverting the
# expected exit. What it does NOT cover is the eight names themselves: deleting one of them
# from the globals list would leave this row green and turn `sdk-lint` red, so the pair pins
# both directions only because `sdk-lint` also runs.
negctl-sdk-lint|0|scripts/orch/node-slim.sh bash -c 'npm ci --ignore-scripts >/dev/null && { printf "undefinedGlobalForNegctl;\n" | npx eslint --max-warnings=0 --stdin --stdin-filename crates/graph-sdk-js/test/negctl.mjs >target/negctl-sdk-lint.txt 2>&1; test $? -eq 1 && grep -q no-undef target/negctl-sdk-lint.txt; }'

