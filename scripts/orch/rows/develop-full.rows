# ---------------------------------------------------------------------------------------------
# from crates/graph-cli/src/hashgate/knob.rs (Knob::ALL, 45 knobs) and
# crates/graph-cli/tests/common/mod.rs (the integration-test clear-list) — the
# knob list, which exists once. One `negctl-<knob>` row per *parameter* control,
# `expect nonzero`: a knob that fails to move the output leaves the gate agreeing with itself.
# The 27 per-stage node controls are not one row each; each is held by
# `each_analysis_and_post_stage_has_its_own_control_that_moves_only_its_stage`, which drives
# every row of `knobs::all()` through both arms of the gate at one seed.
# `negctl-osage-nodes` is here rather than in that group because
# `layout.packing.osage` is the one row `Status::Gated` was refused for want of a control on
# its own stage, so this row is the evidence the ledger now reads back.
#
# `GM_MUTATE_FORCE_THETA=0.5`, not 0.9 — 0.9 was the default, so the control moved nothing
# and the row passed vacuously (prompts/RESUME.md:155).
# `GM_MUTATE_SPLIT_SUM` needs BOTH `--tiers all` and >= 5 seeds: the control reaches the
# stage, not just the arm, and below 5 seeds the run refuses with exit 2
# (docs/reports/phase-11-progress.md:103-108). An `expect nonzero` row would accept that 2
# as a pass, so the row is written to be a real divergence.
# ---------------------------------------------------------------------------------------------
negctl-reference-degree|nonzero|scripts/orch/gr -e GM_MUTATE_REFERENCE_DEGREE=9 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-grid-spacing|nonzero|scripts/orch/gr -e GM_MUTATE_GRID_SPACING=2 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-sugiyama-layer-spacing|nonzero|scripts/orch/gr -e GM_MUTATE_SUGIYAMA_LAYER_SPACING=2 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-node-count|nonzero|scripts/orch/gr -e GM_MUTATE_NODE_COUNT=1 cargo run -q -p graph-cli -- hashgate --seeds 8
# copied verbatim from scripts/orch/rows/p12-t3.rows:84 — the strong form of `negctl-dim-z-mismatch`
# above, which only checks `ne 0` and so would pass on an exit 2 for the wrong reason.
negctl-node-z|0|scripts/orch/gr bash -c 'out=$(GM_MUTATE_NODE_Z=1 cargo run -q -p graph-cli -- roundtrip --seeds 8 2>&1); rc=$?; [ "$rc" = 2 ] || { echo "expected exit 2 (the z-length refusal), got $rc"; echo "$out"; exit 1; }; echo "$out" | grep -q "perturbed exercise seed .*: node\.z: 4 values, need 3" || { echo "the run did not refuse on the z column it perturbed:"; echo "$out"; exit 1; }'
negctl-force-theta|nonzero|scripts/orch/gr -e GM_MUTATE_FORCE_THETA=0.5 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-fa2-scaling-ratio|nonzero|scripts/orch/gr -e GM_MUTATE_FA2_SCALING_RATIO=3 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-tree-tidy-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_TREE_TIDY_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-treemap-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_TREEMAP_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-circular-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_CIRCULAR_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-packing-scale|nonzero|scripts/orch/gr -e GM_MUTATE_PACKING_SCALE=2 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-osage-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_PACKING_OSAGE_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-split-sum|nonzero|scripts/orch/gr -e GM_MUTATE_SPLIT_SUM=collide cargo run -q -p graph-cli -- hashgate --seeds 8 --tiers all
# the other two split-sum values, and the vacuity refusal (docs/reports/phase-11-progress.md:86-108)
negctl-split-sum-charge|nonzero|scripts/orch/gr -e GM_MUTATE_SPLIT_SUM=charge cargo run -q -p graph-cli -- hashgate --seeds 8 --tiers all
negctl-split-sum-link|nonzero|scripts/orch/gr -e GM_MUTATE_SPLIT_SUM=link cargo run -q -p graph-cli -- hashgate --seeds 8 --tiers all
negctl-split-sum-refuse|nonzero|scripts/orch/gr -e GM_MUTATE_SPLIT_SUM=collide cargo run -q -p graph-cli -- hashgate --seeds 2 --tiers all

