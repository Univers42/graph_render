# The osage differential (scripts/orch/rows/p13-gv1-osage.rows): `layout.packing.osage` is gated
# on an `oracle-osage` record, and no other row here writes one.
osage-emit-1000|0|scripts/orch/gr cargo run -q -p graph-cli -- emit-graphviz-fixtures --engine osage --seeds 1000
osage-oracle-1000|0|scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/osage-fixtures osage target/gv-osage --differential
osage-check-1000|0|scripts/orch/gr cargo run -q -p graph-cli -- oracle-graphviz --engine osage
osage-check-negctl|nonzero|scripts/orch/gr cargo run -q -p graph-cli -- oracle-graphviz --engine osage --dir target/osage-fixtures-absent

# Last: `capabilities --check` reads the records every gate above writes for this tree
# (hashgate, roundtrip, oracle-diff, oracle-spectral, oracle-osage). Run earlier, it reports
# each one missing or stale (2026-10-04, gate-develop-bff2: 34 problems at row 46).
