# ---------------------------------------------------------------------------------------------
sugiyama-invariants|0|scripts/orch/gr cargo test -p graph-core sugiyama_invariants
dag-dump|0|scripts/orch/gr cargo test -p graph-core dump_crossing_measurements -- --ignored
oracle-layouts-dag|0|scripts/orch/node-slim.sh bash -c 'npm ci --ignore-scripts >/dev/null && node harness/oracle-layouts.mjs --dag'

