# The service gate (docs/contract/service-api.md "Round 1", conditions 2, 3, 4, 9, 11, 12).
# Format `name|expect|cmd`, the same as scripts/orch/rows/quick.rows; run by scripts/orch/gate.sh.
# A `negctl-` row re-runs the test above with one break on and passes only when that test goes
# red for its own reason. The breaks live in server/graph-server/src/breaks.rs and exist only
# under the `negctl` feature, so every `negctl-` row builds with `--features negctl` and names
# its break in `GM_SVC_BREAK`.
# A `negctl-` row asserts exit 101 and a `test result: FAILED` line: `cargo test` maps both a test
# failure and a build failure to 101, and only a test that ran and failed prints that line.
# The four rows added in round 2 also name the test function their break must turn red, and they
# drop `-q` so that `test <fn> ... FAILED` is in the log: without it a red test binary that failed
# for some other reason would still pass the row.

# Condition 4, request order and connection limits: a keyless body is refused before a byte of it
# is buffered, and a head sent at 1 byte/s is cut at GRAPH_HEADER_TIMEOUT_MS.
svc-preauth|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test preauth
negctl-preauth|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=body-before-auth cargo test -q --manifest-path server/Cargo.toml --features negctl --test preauth 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out"
negctl-slow-headers|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=no-header-timeout cargo test -q --manifest-path server/Cargo.toml --features negctl --test preauth 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out"

# Condition 9 at start: every refused key file and every refused setting is exit 2, naming the
# line number or the variable and never the line, the path or the value.
svc-exit2|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test start
negctl-exit2|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=accept-group-writable cargo test -q --manifest-path server/Cargo.toml --features negctl --test start 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out"

# Condition 9, SIGHUP: the whole file is parsed, then the key set is swapped at once; a bad or
# empty file keeps the old set.
svc-sighup|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test reload
negctl-sighup|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=ignore-sighup cargo test -q --manifest-path server/Cargo.toml --features negctl --test reload 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out"

# Condition 11: `graph-server healthcheck`, the image's HEALTHCHECK, exits 0 only on a live server
# and 1 on a closed port or a listener that never answers.
svc-healthcheck|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test health
negctl-healthcheck|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=always-healthy cargo test -q --manifest-path server/Cargo.toml --features negctl --test health 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out"

# Condition 12: SIGTERM stops new connections at once, the request in flight finishes with its
# normal status, and the process exits 0 within GRAPH_TIMEOUT_MS.
svc-shutdown|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test shutdown
negctl-shutdown|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=no-drain cargo test -q --manifest-path server/Cargo.toml --features negctl --test shutdown 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out"

# Condition 2, work caps: cap + 1 for every registry id is a 413 IngestTooLarge within a second.
# `--release` because that one-second bound is for an optimised build and is ignored in debug.
svc-caps|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --release --test caps
negctl-caps|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=lift-caps cargo test -q --manifest-path server/Cargo.toml --features negctl --release --test caps 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out"

# Condition 9, auth.rs: a missing, wrong or truncated key is the same 401 with a
# `WWW-Authenticate: Bearer`, and a good key is 200. Negctl: `any-key` (src/auth.rs) makes every
# well-formed credential the key name "any-key", so the named test must go red.
svc-auth|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test auth
negctl-svc-auth|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=any-key cargo test --manifest-path server/Cargo.toml --features negctl --test auth 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out" && grep -q '^test a_missing_wrong_or_truncated_key_is_401_with_a_challenge \.\.\. FAILED$' <<<"$out"

# Condition 9 and 12, observe.rs: no log line holds the key, its hash, or the word that introduces
# one. Negctl: `log-header` (src/observe.rs) puts the raw `Authorization` on the line.
svc-log|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test log
negctl-svc-log|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=log-header cargo test --manifest-path server/Cargo.toml --features negctl --test log 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out" && grep -q '^test no_line_holds_the_key_or_its_hash \.\.\. FAILED$' <<<"$out"

# Condition 10, embed.rs: a file is served public and immutable under its content version, and
# every path outside the table is a 404 — traversal, a directory, a dotfile, `VERSION`, and both
# symlinks that point out of GRAPH_EMBED_DIR. Negctl: `follow-symlinks` (src/embed.rs) walks with
# `metadata` instead of `symlink_metadata`, so `escape.js` and `linked/secret.js` come back 200.
svc-embed|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test embed
negctl-svc-embed|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=follow-symlinks cargo test --manifest-path server/Cargo.toml --features negctl --test embed 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out" && grep -q '^test every_path_outside_the_files_is_404 \.\.\. FAILED$' <<<"$out"

# Condition 5, layout.rs: the permit moves into the blocking closure, so a run answered 503 at its
# deadline keeps its slot until it ends — workers + queue more requests are 429 until then — and a
# panic is a 500 with the next run a 200. Negctl: `drop-permit` (src/layout.rs) leaves the permit
# outside the closure, so the slot frees at the timeout.
svc-slots|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --test limits
negctl-svc-slots|0|out=$(scripts/orch/gr -e GM_SVC_BREAK=drop-permit cargo test --manifest-path server/Cargo.toml --features negctl --test limits 2>&1); rc=$?; printf '%s\n' "$out"; test $rc -eq 101 && grep -q '^test result: FAILED' <<<"$out" && grep -q '^test a_timed_out_run_keeps_its_slot_until_it_ends \.\.\. FAILED$' <<<"$out"

# Condition 3, memory budget: the worker count is min(cores, floor(memory.max / PER_SLOT_BYTES)),
# from src/config/slots.rs (4_635_677_069, the contract ingest term binding). Eight GiB holds one
# slot, so the server starts and serves; one GiB
# holds none, so it refuses to start with exit 2. GRAPH_WORKERS is left unset in both rows: an
# explicit count overrides the derivation (src/config.rs:166-175).
# Caveat: the derivation itself is proved by config/tests.rs:73, not here; this row only proves
# the container's memory.max reaches the server and that it is refused when it does not.
svc-memory|0|out=$(timeout -s TERM 20 scripts/orch/drun --rm --memory 8g --memory-swap 8g -e GRAPH_AUTH=off -e GRAPH_BIND=127.0.0.1 "$(scripts/service.sh image)" 2>&1); grep -q '"event":"listening"' <<<"$out"
negctl-memory|0|out=$(scripts/orch/drun --rm --memory 1g --memory-swap 1g -e GRAPH_AUTH=off -e GRAPH_BIND=127.0.0.1 "$(scripts/service.sh image)" 2>&1); rc=$?; test $rc -eq 2 && grep -q 'GRAPH_WORKERS: unset, and memory.max holds no slot' <<<"$out"