studio-check|0|scripts/studio.sh check
studio-build|0|scripts/studio.sh build
studio-embed|0|scripts/studio-embed.sh
# The control needs its own fresh report, not only exit 1: a SyntaxError in smokecdp.py (a merge
# conflict, 2026-10-04) also exits 1, and the bare `test $? -eq 1` row passed on it. 19 = the targeted rows.
negctl-studio-embed|0|r=target/studio-embed/break/report.json; rm -f $r; STUDIO_EMBED_BREAK=1 scripts/studio-embed.sh; test $? -eq 1 && test "$(grep -c '"verdict": "FAIL"' $r)" -ge 19 && ! grep -Eq '"verdict": "(PASS|NOT-RUN)"' $r
# The pack rows, from target/wf/studio-pack.rows. Each builds into its own outdir: the control must
# leave a whole pack behind for studio-pack-embed, which serves target/pack/graph-studio-0.1.0.
studio-pack|0|scripts/studio-pack.sh target/pack
# Its own outdir, and the reason read from its log, not only from $?: a build that never ran is not a
# control that bit. The verify must name the file it deleted.
negctl-studio-pack|0|log=target/pack-break.log; STUDIO_PACK_BREAK=1 scripts/studio-pack.sh target/pack-break >$log 2>&1; test $? -eq 1 && grep -q graph_wasm_threads.wasm $log
# One tree, two outdirs, one digest. A commit landing between the two builds moves pack.json's
# source_rev and the digests differ: that is the row saying the tree was not the same tree.
studio-pack-repro|0|scripts/studio-pack.sh target/pack-a >/dev/null && scripts/studio-pack.sh target/pack-b >/dev/null && cmp <(sha256sum < target/pack-a/graph-studio-0.1.0.tgz) <(sha256sum < target/pack-b/graph-studio-0.1.0.tgz)
studio-pack-embed|0|STUDIO_EMBED_PACK=target/pack/graph-studio-0.1.0 scripts/studio-embed.sh
# As negctl-studio-embed, over the pack, for the same reason: a SyntaxError in the harness also
# exits 1. 19 = the targeted rows, every one of them FAIL, none left NOT-RUN.
negctl-studio-pack-embed|0|r=target/studio-embed/break-pack/report.json; rm -f $r; STUDIO_EMBED_PACK=target/pack/graph-studio-0.1.0 STUDIO_EMBED_BREAK=1 scripts/studio-embed.sh; test $? -eq 1 && test "$(grep -c '"verdict": "FAIL"' $r)" -ge 19 && ! grep -Eq '"verdict": "(PASS|NOT-RUN)"' $r
# The service bundle a host imports, and the two predicates over it that the pack alone used to
# have (docs/reviews/review-bundle-unify.md sections 0 and 2): the worker form, and the staged file
# list against the one docs/deploy/service.md documents. Both read `scripts/studio.sh embed`'s
# output, which scripts/service.sh:81,84 moves whole into the image's stage.
embed-bundle|0|scripts/studio.sh embed target/embed-bundle && scripts/worker-form.sh target/embed-bundle && scripts/embed-files.sh target/embed-bundle
# The worker predicate's own controls, in one row and in this order: the multi-line `new Worker`
# the review's `[^)]*` grep could not see must PASS, the same fixture plus a `blob:` worker must
# exit 1 naming bad.js, and a bundle with no worker at all must exit 1 rather than pass vacuously.
negctl-worker-form|0|f=target/worker-form-fixture; rm -rf $f; mkdir -p $f; printf 'new Worker(new URL(\n"x.js",import.meta.url))\n' >$f/ok.js; scripts/worker-form.sh $f >/dev/null || exit 1; printf 'new Worker(URL.createObjectURL(new Blob([""])))\n' >$f/bad.js; out=$(scripts/worker-form.sh $f 2>&1); test $? -eq 1 && printf '%s' "$out" | grep -q bad.js || exit 1; e=target/worker-form-empty; rm -rf $e; mkdir -p $e; scripts/worker-form.sh $e >/dev/null 2>&1; test $? -eq 1
# The file list's own controls, over a copy of the bundle embed-bundle built: a top-level file the
# document does not name must be refused by name, and a documented file that is gone must be too.
negctl-embed-files|0|b=target/embed-files-break; rm -rf $b; cp -r target/embed-bundle $b; printf '// stray\n' >$b/stray.js; out=$(scripts/embed-files.sh $b 2>&1); test $? -eq 1 && printf '%s' "$out" | grep -q stray.js || exit 1; cp target/embed-bundle/graph-sdk.js $b/graph-sdk.js && python3 -c "import os,sys; os.remove(sys.argv[1])" $b/graph-sdk.js; out=$(scripts/embed-files.sh $b 2>&1); test $? -eq 1 && printf '%s' "$out" | grep -q graph-sdk.js
# The consumer the review found missing: the built graph-sdk.js, loaded as served and asked to lay
# out fixtures/force/clustered.json. Without this row the file was built, staged and served by
# nobody, and deleting it would have changed <version> and every host's tag for no reader.
embed-sdk|0|scripts/orch/node-slim.sh node harness/sdk-bundle-smoke.mjs target/embed-bundle
# Its control, read from the log and not only from $?: a harness that exits 1 for any reason would
# satisfy `test $? -eq 1`, so the refusal's error NAME has to be in the output as well.
negctl-embed-sdk|0|b=target/embed-sdk-break; rm -rf $b; cp -r target/embed-bundle $b; log=target/embed-sdk-break.log; python3 -c "import sys; p=sys.argv[1]; d=open(p,'rb').read(); open(p,'wb').write(d[:64])" $b/graph_wasm.wasm; scripts/orch/node-slim.sh node harness/sdk-bundle-smoke.mjs $b >$log 2>&1; test $? -eq 1 && grep -q 'WasmUnavailableError' $log
