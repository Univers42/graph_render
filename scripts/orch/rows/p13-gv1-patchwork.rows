# p13-gv1-patchwork — the merge floor, the two wasm32 builds, the hash gate at 8 seeds, one
# `negctl-<knob>` row per relevant knob, and the patchwork differential's three steps.
#
# Copied from `scripts/orch/rows/quick.rows` (the merge floor plus wasm32 and hashgate 8),
# with the differential's own chain appended in the three-step shape
# `scripts/orch/rows/p13-gv1-osage.rows` uses for the other Graphviz engines.
#
# The timed gates — `hashgate --seeds 1000`, `scripts/orch/gate.sh`, `scripts/orch/mutants.sh` —
# are the orchestrator's and are not rows here: one timed gate at a time (CLAUDE.md).
# `expect` is `0` or `nonzero`; `#` starts a comment (`scripts/orch/gate.sh:2-4`).

fmt|0|scripts/orch/gr cargo fmt --all --check
clippy|0|scripts/orch/gr cargo clippy --workspace --all-targets -- -D warnings
test|0|scripts/orch/gr cargo test --workspace --no-fail-fast
wasm32-core|0|scripts/orch/gr cargo build -p graph-core --target wasm32-unknown-unknown
wasm32-motor|0|scripts/orch/gr cargo build -p graph-wasm --release --target wasm32-unknown-unknown
hashgate-8|0|scripts/orch/gr cargo run -q -p graph-cli -- hashgate --seeds 8

# The negative controls. The knobs list exists once, in
# `crates/graph-cli/src/hashgate/knob/arms.rs:21` (`Knob::ALL`, the `const` the ledger walks);
# every knob below must turn the gate red, and a knob that perturbs a stage nothing else
# reaches must move that stage alone. The first is this branch's own: `layout.treemap.patchwork`
# is a closed form with no parameter of its own — it pins Graphviz's default `area` of 1 and no
# `inset` — so its control re-draws that stage's own model with one more node, exactly as the
# other node controls do (`hashgate/tests/knob/patchwork.rs`). Measured here: it diverges on
# `layout.treemap.patchwork` and on no other stage.
negctl-patchwork-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_PATCHWORK_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
# The rest are here because the register they share with the twenty-sixth layout is what keeps
# them honest: a per-stage control whose stage moved under it would move more than one stage.
negctl-reference-degree|nonzero|scripts/orch/gr -e GM_MUTATE_REFERENCE_DEGREE=9 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-grid-spacing|nonzero|scripts/orch/gr -e GM_MUTATE_GRID_SPACING=2 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-sugiyama-layer-spacing|nonzero|scripts/orch/gr -e GM_MUTATE_SUGIYAMA_LAYER_SPACING=2 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-node-count|nonzero|scripts/orch/gr -e GM_MUTATE_NODE_COUNT=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-force-theta|nonzero|scripts/orch/gr -e GM_MUTATE_FORCE_THETA=0.5 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-fa2-scaling-ratio|nonzero|scripts/orch/gr -e GM_MUTATE_FA2_SCALING_RATIO=3 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-spring-iterations|nonzero|scripts/orch/gr -e GM_MUTATE_SPRING_ITERATIONS=20 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-tree-tidy-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_TREE_TIDY_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-treemap-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_TREEMAP_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-circular-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_CIRCULAR_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-circular-hierarchy-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_CIRCULAR_HIERARCHY_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-twopi-nodes|nonzero|scripts/orch/gr -e GM_MUTATE_TWOPI_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-packing-scale|nonzero|scripts/orch/gr -e GM_MUTATE_PACKING_SCALE=2 cargo run -q -p graph-cli -- hashgate --seeds 8
# The two split controls reach a stage the default tier set does not run, so they carry
# `--tiers all` exactly as `scripts/orch/rows/p13-gv1.rows` does: without it they perturb
# nothing and the row would be green with the knob set — a negative control that cannot fail.
negctl-split-sum|nonzero|scripts/orch/gr -e GM_MUTATE_SPLIT_SUM=collide cargo run -q -p graph-cli -- hashgate --seeds 8 --tiers all
negctl-split-rescale|nonzero|scripts/orch/gr -e GM_MUTATE_SPLIT_RESCALE=1 cargo run -q -p graph-cli -- hashgate --seeds 8 --tiers all

# The patchwork differential at the seed count it is measured at
# (docs/measurements/p13-gv1-patchwork.md): emit the fixtures into `target/patchwork-fixtures`,
# run Graphviz's own engine over them in the pinned docker-only oracle image — which is also the
# command that writes `<engine>-result.json` the check reads — then check the result against the
# measured ceiling and record it. The oracle rows are the only ones here that talk to Docker.
patchwork-emit-1000|0|scripts/orch/gr cargo run -q -p graph-cli -- emit-graphviz-fixtures --engine patchwork --seeds 1000
patchwork-oracle-1000|0|scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-fixtures patchwork target/patchwork-fixtures --differential
patchwork-check-1000|0|scripts/orch/gr cargo run -q -p graph-cli -- oracle-graphviz --engine patchwork

# The oracle is deterministic: the same 1000 fixtures through `patchwork` twice, byte for byte.
# This is the evidence the ADR's determinism claim rests on, run as a row so it cannot rot.
patchwork-oracle-determinism|0|scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-fixtures patchwork target/gv-patchwork-cmp-a --differential && scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-fixtures patchwork target/gv-patchwork-cmp-b --differential && cmp target/gv-patchwork-cmp-a/graphviz-patchwork.jsonl target/gv-patchwork-cmp-b/graphviz-patchwork.jsonl

# `-Gstart` is inert for this engine, and that is a measurement rather than an assumption:
# the same 1000 fixtures at start=1, 7 and 99 are byte-identical. All three runs use the plain
# positional call, so all three write the same record shape and `cmp` is meaningful — comparing
# a `--differential` output against a positional one differs in the JSON keys alone and would
# prove nothing.
patchwork-oracle-start-inert|0|scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-fixtures patchwork target/gv-patchwork-start1 --fixtures=patchwork.jsonl --start=1 && scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-fixtures patchwork target/gv-patchwork-start7 --fixtures=patchwork.jsonl --start=7 && scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-fixtures patchwork target/gv-patchwork-start99 --fixtures=patchwork.jsonl --start=99 && cmp target/gv-patchwork-start1/graphviz-patchwork.jsonl target/gv-patchwork-start7/graphviz-patchwork.jsonl && cmp target/gv-patchwork-start1/graphviz-patchwork.jsonl target/gv-patchwork-start99/graphviz-patchwork.jsonl

# **Control 1: the oracle's output for this engine is read to the last digit.** Two runs of the
# *same* 20 fixtures (a and b) are byte-identical; then one node coordinate of one seed in b is
# moved by 1e-6 points — a millionth of a point, four orders of magnitude below anything the
# layout computes — and the byte comparison must fail. Without it, "the two runs are identical"
# could mean "the comparison never looks". Both sides must come from the same fixture set:
# comparing a 20-seed output against the 1000-seed one would differ in the seed count alone and
# pass with the perturbation deleted, which is a control that cannot fail.
patchwork-oracle-perturb-negctl|nonzero|scripts/orch/gr cargo run -q -p graph-cli -- emit-graphviz-fixtures --engine patchwork --seeds 20 --out target/patchwork-negctl && scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-negctl patchwork target/gv-patchwork-negctl-a --differential && scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 harness/oracle-graphviz.py target/patchwork-negctl patchwork target/gv-patchwork-negctl-b --differential && scripts/orch/drun --rm --pull never --user 0:0 -v "$PWD:/w" -w /w ge-graphviz-oracle python3 -c "import json; p='target/gv-patchwork-negctl-b/graphviz-patchwork.jsonl'; rows=[json.loads(l) for l in open(p)]; rows[0]['points'][0][0] += 1e-6; open(p, 'w').write('\n'.join(json.dumps(r) for r in rows) + '\n')" && cmp target/gv-patchwork-negctl-a/graphviz-patchwork.jsonl target/gv-patchwork-negctl-b/graphviz-patchwork.jsonl

# **Control 2: the check cannot pass on nothing.** A directory with no recorded run must be
# refused rather than read as a pass — the same shape
# `scripts/orch/rows/p13-gv1-osage.rows` uses for the osage oracle.
patchwork-check-negctl|nonzero|scripts/orch/gr cargo run -q -p graph-cli -- oracle-graphviz --engine patchwork --dir target/patchwork-fixtures-absent

# **Control 3: an engine no differential answers.** `--engine`'s parser lists `twopi`, `osage`
# and `patchwork`, so the CLI refuses the name before it writes anything; the row is here because
# a parser that accepted a fourth name would compare nothing and say PASS.
patchwork-engine-negctl|nonzero|scripts/orch/gr cargo run -q -p graph-cli -- oracle-graphviz --engine circo