ct|0|grep -q '%ct' examples/plugins/git/git-log.sh && grep -q '%ct' examples/plugins/git/map.mjs && ! grep -q '%at' examples/plugins/git/git-log.sh examples/plugins/git/map.mjs examples/plugins/git/synthetic.mjs
