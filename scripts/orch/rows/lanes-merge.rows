# lanes-merge: the lanes sharing rule (motor), its oracle and digests. The plugin's %ct switch lands apart (git-plugin-ct).
fmt|0|scripts/orch/gr cargo fmt --all --check
clippy|0|scripts/orch/gr cargo clippy --workspace --all-targets -- -D warnings
test|0|scripts/orch/gr cargo test --workspace --no-fail-fast
wasm32-core|0|scripts/orch/gr cargo build -p graph-core --target wasm32-unknown-unknown
hashgate-8|0|scripts/orch/gr cargo run -q -p graph-cli -- hashgate --seeds 8
negctl-degree|0|scripts/orch/gr -e GM_MUTATE_REFERENCE_DEGREE=9 cargo run -q -p graph-cli -- hashgate --seeds 8; test $? -eq 1
negctl-dim-z-mismatch|0|scripts/orch/gr -e GM_MUTATE_NODE_Z=1 cargo run -q -p graph-cli -- roundtrip --seeds 8; test $? -ne 0
force-gate-4|0|scripts/orch/gr cargo run -q -p graph-cli -- force-gate --seeds 4
negctl-force-gravity|0|scripts/orch/gr -e GM_MUTATE_FORCE_SESSION_GRAVITY=0.5 cargo run -q -p graph-cli -- force-gate --seeds 4; test $? -eq 1
negctl-drop-delta|0|scripts/orch/gr -e GM_MUTATE_DROP_DELTA=1 cargo run -q -p graph-cli -- force-gate --seeds 4; test $? -eq 1
scigraphs-conformance|0|scripts/scigraphs-conformance.sh
negctl-scigraphs-conformance|0|scripts/scigraphs-conformance.sh --break; test $? -eq 1
roundtrip-100|0|scripts/orch/gr cargo run -q -p graph-cli -- roundtrip --seeds 100
codegen|0|scripts/orch/gr cargo run -q -p graph-cli -- codegen --check
negctl-dag-lanes-nodes|0|scripts/orch/gr -e GM_MUTATE_DAG_LANES_NODES=1 cargo run -q -p graph-cli -- hashgate --seeds 8; test $? -eq 1
no-source-names|0|test -e crates/graph-core/src/layout/lanes.rs && test -z "$(git grep -n -i -E '\bgit\b|commit|repositor|activitywatch' -- crates/graph-core/src/layout/lanes.rs crates/graph-core/src/layout/lanes crates/graph-core/src/registry/lanes.rs crates/graph-cli/src/snapshot_cmd/hand_oracles/lanes.rs)"
svc-fmt|0|scripts/orch/gr cargo fmt --manifest-path server/Cargo.toml --all --check
svc-clippy|0|scripts/orch/gr cargo clippy --manifest-path server/Cargo.toml --workspace --all-targets -- -D warnings
svc-test|0|scripts/orch/gr cargo test --manifest-path server/Cargo.toml --workspace --no-fail-fast
plugin-test|0|scripts/orch/node-slim.sh node --experimental-strip-types --test "examples/plugins/git/test/*.test.mjs"
bench-smoke|0|CARGO_BUILD_JOBS=3 scripts/orch/gr cargo build -q -p graph-wasm --release --target wasm32-unknown-unknown && scripts/orch/node-slim.sh node --experimental-strip-types examples/plugins/git/bench.mjs target/wasm32-unknown-unknown/release/graph_wasm.wasm examples/plugins/git/test/small.gitlog | grep -q "layout.dag.lanes.width=[1-9]"
negctl-bench-smoke|0|CARGO_BUILD_JOBS=3 scripts/orch/gr cargo build -q -p graph-wasm --release --target wasm32-unknown-unknown && scripts/orch/node-slim.sh node --experimental-strip-types examples/plugins/git/bench.mjs target/wasm32-unknown-unknown/release/graph_wasm.wasm examples/plugins/git/test/bad.gitlog | grep -q "layout.dag.lanes.width=[1-9]"; test $? -eq 1
named-test|0|git grep -q 'fn three_lines_forked_from_one_base_share_the_column_waiting_for_it' -- crates/graph-core/src/layout/lanes
no-plugin|0|b=$(git merge-base HEAD origin/develop); test -z "$(git diff --name-only "$b" -- examples; git status --porcelain --untracked-files=all -- examples)"
named-test-d|0|git grep -q 'fn a_line_bends_left_into_a_column_already_waiting_and_keeps_a_fresh_one_for_its_third_edge' -- crates/graph-core/src/layout/lanes && git grep -q 'a_line_bends_left_into_a_column_already_waiting_and_keeps_a_fresh_one_for_its_third_edge' -- crates/graph-core/src/registry/lanes.rs
pins-kept|0|git grep -qF 'assert_eq!(x, [0.0, 0.0, 1.0, 0.0], "a, b, c, m");' -- crates/graph-core/src/layout/lanes && git grep -qF 'assert_eq!(paths.pts, [1.0, 1.5, 1.0, 0.5], "source c to target a");' -- crates/graph-core/src/layout/lanes
