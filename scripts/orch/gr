#!/usr/bin/env bash
# gr [-e K=V]... <cmd...> — run <cmd> in the ge-rust image (or $GR_IMAGE) with the current git
# top-level mounted at /w and the cargo registry in a named volume. Docker-only toolchain (rule 0.2).
set -euo pipefail
top=$(git rev-parse --show-toplevel)
envs=()
while [[ ${1-} == -e ]]; do envs+=(-e "$2"); shift 2; done
# CARGO_BUILD_JOBS / RUST_TEST_THREADS pass through so parallel builder jobs cannot starve a timed gate
# run (runner.rs CHILD_TIMEOUT). Ponytail: a thread cap, not a CPU cap (docker --cpus is unsupported on
# this kernel) — one job's test binary spawning its own threads can still exceed it.
for v in CARGO_BUILD_JOBS RUST_TEST_THREADS; do [[ -n ${!v-} ]] && envs+=(-e "$v=${!v}"); done
exec docker run --rm ${envs[@]+"${envs[@]}"} -v "$top:/w" -w /w \
  -v ge-cargo-registry:/opt/cargo/registry "${GR_IMAGE:-ge-rust}" "$@"
